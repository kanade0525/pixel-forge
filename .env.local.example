# ローカル開発でAI生成を試すための環境変数のテンプレートです。
# このファイルをコピーして「.env.local」を作り、キーを記入してください（.env.local は git 管理外）。
#
#   cp .env.local.example .env.local
#
# Google AI Studio でキーを作成: https://aistudio.google.com/api-key
GEMINI_API_KEY=ここに自分のGoogle AI StudioのAPIキー

# 使う画像生成モデル（省略時は gemini-2.5-flash-image = Nano Banana）。
# 例: gemini-3.1-flash-image など新モデルへ差し替えたいとき。
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
